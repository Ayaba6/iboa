# A3 ERP — Modèle d'environnement STAGING
# Copier vers .env sur le serveur de staging, puis : php artisan key:generate
# NE PAS committer de .env réel.

APP_NAME="A3 ERP"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Africa/Ouagadougou
APP_URL=https://staging.a3erp.example
APP_LOCALE=fr

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iboa_erp_staging
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

# Intégrations mobile money : laisser vides en staging (webhooks refusés sans
# integration active — voir module Intégrations pour saisir les clés).
